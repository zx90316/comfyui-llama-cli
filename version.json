{
    "name": "ComfyUI Llama.cpp CLI Node",
    "version": "2.0.0",
    "description": "ComfyUI custom nodes for llama.cpp CLI - direct subprocess control without running a server",
    "author": "",
    "license": "MIT",
    "comfyui_version": ">=1.0.0",
    "dependencies": [
        "pillow>=8.0.0",
        "numpy"
    ],
    "supported_binaries": [
        "llama-cli",
        "llama-embedding"
    ],
    "nodes": [
        "LlamaCliConfig",
        "LlamaGenerate",
        "LlamaChat",
        "LlamaEmbedding",
        "LlamaInfill",
        "LlamaImageEncoder",
        "LlamaProcessMonitor"
    ],
    "features": [
        "Direct subprocess control (no server required)",
        "One-shot and keep-alive VRAM management modes",
        "GGUF model dropdown via ComfyUI folder_paths",
        "Full sampling parameter support (DRY, XTC, Mirostat, Dynamic Temperature)",
        "Grammar and JSON Schema constraints",
        "Multimodal vision support (mmproj + image)",
        "Speculative decoding (draft-mtp, eagle3, ngram)",
        "KV cache type configuration",
        "Code infill (Fill-in-the-Middle)",
        "Text embeddings",
        "Process monitoring and manual VRAM release",
        "Automatic cleanup on ComfyUI shutdown"
    ],
    "node_count": 7,
    "category": "AI/LlamaCpp"
}
